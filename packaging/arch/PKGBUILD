# Maintainer: Your Name <your@email.example>
# Arch Linux packaging template kept in the upstream repository: builds from a
# source tag and installs files managed by pacman. The AUR repository holds the
# user-facing PKGBUILD once published; this one keeps the packaging logic in
# sync with the source tree and documents a verified build recipe.

pkgname=hindsight
pkgver=0.11.1
pkgrel=1
pkgdesc="Privacy-first activity tracking and AI summaries for desktop"
arch=(x86_64)
url="https://github.com/Tomotsugu-dev/Hindsight"
license=(GPL-3.0-only)
# gtk3/webkit2gtk-4.1 are required by the Tauri 2 Linux runtime; tray support
# comes from libayatana-appindicator. libdbus is pulled in transitively and
# already declared by gtk3, so it is not listed again.
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator')
# nodejs>=20 comes from the "engines" field in package.json; rust may come from
# the official package or rustup, makepkg only needs a working cargo toolchain.
# Dependencies containing >= must be quoted, otherwise bash reads them as a
# redirection.
makedepends=('git' 'nodejs>=20' 'npm' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Generated with makepkg -g; update when bumping pkgver. codeload.github.com
# may drop connections on some networks; use a proxy or curl -C - to resume.
sha512sums=('84d28512378359f8d06ae9a8a187e397a2499fe70abe6d4f37670018dc0adef75a8acaf95fac339eb35d40e1706d73572ed551b68bb267df6e4e5f1c113c3df4')
# strip: the Rust release binary is already linked with -Wl,--strip-all, so
# there is nothing left to strip. debug: would only create empty /usr/src/debug
# directories because the release build has no debug info to split out.
options=(!strip !debug !lto)

prepare() {
  # The GitHub tag tarball extracts to Hindsight-<version> (capital H, the
  # repository name), not the lowercase pkgname, so do not build the path from
  # $pkgname.
  cd "Hindsight-$pkgver"
  # npm ci needs network access in the makepkg environment; use the system
  # node instead of nvm.
  export npm_config_yes=true
}

build() {
  cd "Hindsight-$pkgver"
  # The CFLAGS/LDFLAGS exported by makepkg by default break the final Rust
  # link: lto=auto makes rustc use lld with -Wl,--strip-all, and the bundled
  # sqlite static library symbols go missing (verified: the link fails with
  # many "undefined symbol: sqlite3_*" errors). Clear them and let cargo
  # control its own compilation.
  export CFLAGS=""
  export CXXFLAGS=""
  export LDFLAGS=""
  export CPPFLAGS=""
  # Lint is already enforced in upstream CI; skipping it here avoids eslint
  # slowing down the package build and version drift risks.
  npm ci --no-audit --no-fund
  # --no-bundle: produce the native ELF only, no deb/rpm; the Arch package
  # layout is owned by this PKGBUILD.
  npm run tauri build -- --no-bundle
}

package() {
  cd "Hindsight-$pkgver"
  # Main binary
  install -Dm755 src-tauri/target/release/hindsight \
    "$pkgdir/usr/bin/hindsight"

  # hicolor icons: multi-size PNGs shipped by Tauri (icon.png is 512x512,
  # 128x128@2x.png is 256x256, both verified). Install each under the hicolor
  # directory matching its real pixel size so sizes and directory names agree.
  _icondir="$pkgdir/usr/share/icons/hicolor"
  install -Dm644 src-tauri/icons/32x32.png \
    "$_icondir/32x32/apps/hindsight.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$_icondir/128x128/apps/hindsight.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$_icondir/256x256/apps/hindsight.png"
  install -Dm644 src-tauri/icons/icon.png \
    "$_icondir/512x512/apps/hindsight.png"

  # The .desktop file comes from the PKGBUILD directory ($startdir): it is not
  # part of the tag tarball, and $startdir works both inside this repository
  # and in an AUR checkout.
  install -Dm644 "$startdir/hindsight.desktop" \
    "$pkgdir/usr/share/applications/hindsight.desktop"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/hindsight/LICENSE"
}
