# Maintainer: TomokotoKiyoshi <heroburnning at gmail dot com>
# Contributor: xcdmr <https://github.com/xcdmrCHP>

# Arch Linux package for Hindsight, kept in the repository so it stays in step with the source. It
# builds the release tag and installs files managed by pacman. scripts/release.mjs checks that
# pkgver is the version being released, so bump pkgver (and reset pkgrel to 1) with the other
# version numbers. After a release, .github/workflows/aur.yml pushes this folder to the AUR.

# hindsight on the AUR is another program, which also installs /usr/bin/hindsight
pkgname=hindsight-desktop
pkgver=0.11.5
pkgrel=1
pkgdesc="Privacy-first activity tracking and AI summaries for desktop"
arch=(x86_64)
url="https://github.com/Tomotsugu-dev/Hindsight"
license=(GPL-3.0-only)
# The Tauri 2 Linux runtime needs gtk3 and webkit2gtk-4.1, and the tray loads
# libayatana-appindicator. libdbus comes with gtk3
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator')
conflicts=('hindsight')
# nodejs>=20 is the "engines" field of package.json. Quoted: bash would read >= as a redirection
makedepends=('nodejs>=20' 'npm' 'rust')
# The release tarball, not a git checkout: makepkg clones a git source with --mirror, which here is
# 232 MB of history (84 tags) for a 7.5 MB package. The tarball is about 126 MB, and makepkg's HTTP
# downloader retries three times where a git clone gets no retry at all. The checksum is SKIP because
# .github/workflows/aur.yml runs updpkgsums before publishing, so it is regenerated every release
# instead of being bumped by hand; run updpkgsums yourself after a checkout to verify local builds.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        hindsight.desktop)
sha512sums=('SKIP'
            'fbd5313f514be6044856ea7d4929fc639f8ee13be2eb65b522498e1c1a755fbfdb714b6b1b77105e223b73afc55e6e6e18b9890c23fd8bf4a598adedafd16c80')
# strip: cargo already strips the release binary. debug: it has no debug info to split out.
# lto: makepkg's -flto=auto turns the bundled SQLite into GCC LTO objects, and the Rust link then
# cannot find the sqlite3_* symbols
options=(!strip !debug !lto)

prepare() {
  # The tarball unpacks to Hindsight-<version> (capital H, the repository name), not the package
  # name, so every phase has to cd there explicitly
  cd "Hindsight-$pkgver"
  npm ci --no-audit --no-fund
}

build() {
  cd "Hindsight-$pkgver"
  # --no-bundle: only the binary, no deb or rpm. The page is built without the lint, which CI runs
  npm run tauri build -- --no-bundle \
    --config '{"build":{"beforeBuildCommand":"npm run build:notest"}}'
}

package() {
  cd "Hindsight-$pkgver"
  install -Dm755 src-tauri/target/release/hindsight "$pkgdir/usr/bin/hindsight"
  # Each icon goes in the folder of its real size: 128x128@2x.png is 256x256, icon.png 512x512
  local icons="$pkgdir/usr/share/icons/hicolor"
  install -Dm644 src-tauri/icons/32x32.png "$icons/32x32/apps/hindsight.png"
  install -Dm644 src-tauri/icons/64x64.png "$icons/64x64/apps/hindsight.png"
  install -Dm644 src-tauri/icons/128x128.png "$icons/128x128/apps/hindsight.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$icons/256x256/apps/hindsight.png"
  install -Dm644 src-tauri/icons/icon.png "$icons/512x512/apps/hindsight.png"
  install -Dm644 "$srcdir/hindsight.desktop" "$pkgdir/usr/share/applications/hindsight.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
